# ==========================================
# 简历问答智能体 - 环境变量配置
# 上线前复制此文件为 .env 并填入真实值
# ==========================================

# ---- 模型 API 密钥（必填）----
PRIMARY_API_KEY=sk-your-primary-api-key-here
FALLBACK_API_KEY=

# ---- 模型选择（可选，默认值如下）----
# PRIMARY_MODEL=deepseek-chat
# FALLBACK_MODEL=qwen-turbo

# ---- 相似度阈值（可选，默认 0.0）----
# SIMILARITY_THRESHOLD=0.0

# ---- MySQL（必填，请改用强密码）----
MYSQL_ROOT_PASSWORD=请生成一个随机强密码
